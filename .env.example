# Application Configuration
APP_NAME=WhatsApp-Print-System
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-use-a-strong-random-key

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_print.db
DATABASE_SYNC_URL=sqlite:///./whatsapp_print.db

# Storage Configuration
STORAGE_ROOT=./storage/private

# WhatsApp Provider Selection: "openwa" (self-hosted / dev) | "meta" (Meta Cloud API / prod) | "mock"
WHATSAPP_PROVIDER=openwa

# OpenWA Self-Hosted Gateway Configuration (Engine: whatsapp-web.js)
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=printshop_dev
OPENWA_ENGINE=whatsapp-web.js
OPENWA_WEBHOOK_SECRET=

# Meta WhatsApp Business Cloud API Configuration (Used when WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_TOKEN=mock_whatsapp_token
WHATSAPP_VERIFY_TOKEN=mock_verify_token
WHATSAPP_API_VERSION=v19.0

# LLM / NLP Service Configuration
LLM_PROVIDER=mock
LLM_API_KEY=mock_llm_key
LLM_MODEL=gemini-1.5-flash

# Payment Gateway Configuration
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=mock_key_id
PAYMENT_KEY_SECRET=mock_key_secret
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret

# Pricing Configuration (Default in INR)
PRICE_FILE_BASE_CHARGE=5.0
PRICE_BW_SINGLE=2.0
PRICE_BW_DOUBLE=3.0
PRICE_COLOR_SINGLE=10.0
PRICE_COLOR_DOUBLE=15.0
CURRENCY=INR

# Print Agent Configuration
PRINT_AGENT_TOKEN=print_agent_secret_token_123
PRINT_AGENT_ID=agent-local-01
PRINTER_SPEED_PPM=20

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_me
ADMIN_SECRET=admin_secret_token_change_me

# YouPI-PG Gateway & Verification
YOUPI_GATEWAY_URL=http://localhost:6100
YOUPI_WEBHOOK_SECRET=youpi_webhook_secret_change_me
ORDER_PAYMENT_TIMEOUT_MINUTES=10
UTR_VERIFICATION_MODE=strict

# Anti-Abuse & Rate Limiting (50 PDFs per 5 minutes)
RATE_LIMIT_MAX_UPLOADS=50
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_COOLDOWN_SECONDS=300

